{
  "info": {
    "_postman_id": "56bfbc39-2fa5-44bc-9db3-12538f81fd8a",
    "name": "TaniMart API",
    "description": "Koleksi API TaniMart. Jalankan request secara berurutan dari folder 00 sampai 04. Token, ID produk/kurir/metode pembayaran, dan ID pesanan akan disimpan otomatis. Base URL default: http://127.0.0.1:8000/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "customerEmail", "value": "", "type": "string" },
    { "key": "customerPassword", "value": "TaniMart123!", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "cartItemId", "value": "", "type": "string" },
    { "key": "courierId", "value": "", "type": "string" },
    { "key": "paymentMethodId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "createdProductId", "value": "", "type": "string" },
    { "key": "idempotencyKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 - Referensi publik",
      "item": [
        {
          "name": "Daftar produk (menyimpan productId)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/produk?per_page=50",
            "description": "Mengambil produk dan otomatis menyimpan ID produk pertama untuk request keranjang dan checkout."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Daftar produk berhasil diambil', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length > 0) { pm.collectionVariables.set('productId', String(body.data[0].id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Detail produk",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/produk/{{productId}}"
          }
        },
        {
          "name": "Kategori",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/kategori"
          }
        },
        {
          "name": "Banner",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/banners"
          }
        },
        {
          "name": "Daftar kurir (menyimpan courierId)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/kurir"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Daftar kurir berhasil diambil', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length > 0) { pm.collectionVariables.set('courierId', String(body.data[0].id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Metode pembayaran (menyimpan paymentMethodId)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/metode-pembayaran"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Metode pembayaran berhasil diambil', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length > 0) { pm.collectionVariables.set('paymentMethodId', String(body.data[0].id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Daftar wilayah kurir",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/wilayah"
          }
        }
      ]
    },
    {
      "name": "01 - Autentikasi pelanggan",
      "item": [
        {
          "name": "Register pelanggan (membuat token otomatis)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const unique = Date.now() + Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('customerEmail', 'postman+' + unique + '@tokotani.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pelanggan berhasil didaftarkan', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) { pm.collectionVariables.set('customerToken', body.data.token); }",
                  "pm.collectionVariables.set('idempotencyKey', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pelanggan Postman\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"password_confirmation\": \"{{customerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login pelanggan (opsional, menyegarkan token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login pelanggan berhasil', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) { pm.collectionVariables.set('customerToken', body.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Profil pelanggan",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "02 - Keranjang",
      "item": [
        {
          "name": "Lihat keranjang",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/keranjang"
          }
        },
        {
          "name": "Tambah produk (menyimpan cartItemId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Produk berhasil ditambahkan ke keranjang', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) { pm.collectionVariables.set('cartItemId', String(body.data.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produk_id\": {{productId}},\n  \"jumlah\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/keranjang"
          }
        },
        {
          "name": "Ubah jumlah item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jumlah\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/keranjang/{{cartItemId}}"
          }
        },
        {
          "name": "Hapus item keranjang",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/keranjang/{{cartItemId}}"
          }
        },
        {
          "name": "Kosongkan keranjang",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/keranjang"
          }
        }
      ]
    },
    {
      "name": "03 - Checkout dan pesanan",
      "item": [
        {
          "name": "Checkout (menyimpan orderId)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const localToday = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('deliveryDate', localToday);",
                  "if (!pm.collectionVariables.get('idempotencyKey')) { pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout berhasil diproses', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) { pm.collectionVariables.set('orderId', String(body.data.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "X-Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_penerima\": \"Pelanggan Postman\",\n  \"alamat_penerima\": \"Jl. Sayur Segar No. 1, Jakarta\",\n  \"kurir_id\": {{courierId}},\n  \"payment_method_id\": {{paymentMethodId}},\n  \"tanggal_antar\": \"{{deliveryDate}}\",\n  \"slot_pengantaran\": \"pagi\",\n  \"items\": [\n    {\n      \"product_id\": {{productId}},\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/checkout"
          }
        },
        {
          "name": "Ajukan konfirmasi pembayaran",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/pesanan/{{orderId}}/pembayaran"
          }
        },
        {
          "name": "Daftar pesanan pelanggan",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/pesanan"
          }
        },
        {
          "name": "Detail pesanan",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/pesanan/{{orderId}}"
          }
        },
        {
          "name": "Rincian checkout",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/checkout/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "04 - Admin (akun seed lokal)",
      "item": [
        {
          "name": "Login admin seed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login admin berhasil', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) { pm.collectionVariables.set('adminToken', body.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tokotani.test\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Verifikasi pembayaran (status dibayar)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"dibayar\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/pesanan/{{orderId}}/status"
          }
        },
        {
          "name": "Mulai proses pesanan",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"diproses\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/pesanan/{{orderId}}/status"
          }
        },
        {
          "name": "Kirim pesanan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/pesanan/{{orderId}}/kirim"
          }
        },
        {
          "name": "Selesaikan pesanan pelanggan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/pesanan/{{orderId}}/selesai"
          }
        },
        {
          "name": "Tambah produk (menyimpan createdProductId)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testProductName', 'Produk Uji Postman ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Produk berhasil ditambahkan', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) { pm.collectionVariables.set('createdProductId', String(body.data.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"{{testProductName}}\",\n  \"harga\": 5000,\n  \"kategori\": \"Sayuran Segar\",\n  \"stok\": 10,\n  \"tersedia\": true,\n  \"deskripsi\": \"Produk contoh dari koleksi Postman.\",\n  \"satuan_jual\": \"ikat\",\n  \"mudah_rusak\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/produk"
          }
        },
        {
          "name": "Ubah produk uji",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harga\": 6000,\n  \"stok\": 12\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/produk/{{createdProductId}}"
          }
        },
        {
          "name": "Hapus produk uji",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/produk/{{createdProductId}}",
            "description": "Hanya menghapus produk uji yang dibuat oleh request sebelumnya."
          }
        },
        {
          "name": "Logout pelanggan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "noauth"
  }
}
